<h1>Cadastrar Autor</h1>

<form action="/autores/cadastrar" method="POST">

  <h3>Autor:</h3>
  <div>
    <label>Nome:</label>
    <input type="text" name="nome" required>
  </div>
  <br>

  <h3>Livro 1:</h3>
  <div>
    <label>Título do Livro 1:</label>
    <input type="text" name="titulo1" required>
  </div>
  <br>

  <div>
    <label>Ano de Publicação do Livro 1:</label>
    <input type="number" name="anoPublicacao1" required>
  </div>
  <br>

  <h3>Livro 2:</h3>
  <div>
    <label>Título do Livro 2:</label>
    <input type="text" name="titulo2" required>
  </div>
  <br>

  <div>
    <label>Ano de Publicação do Livro 2:</label>
    <input type="number" name="anoPublicacao2" required>
  </div>
  <br>

  <button type="submit">Salvar</button>

</form>
