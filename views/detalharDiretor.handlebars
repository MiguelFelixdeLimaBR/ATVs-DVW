<h1>{{diretor.nome}}</h1>

<p>Ano de nascimento: {{diretor.anoNascimento}}</p>
<p>Nacionalidade: {{diretor.nacionalidade}}</p>

<label>Filmes dirigidos:</label>
<ul>
    {{#if diretor.filmes}}
        {{#each diretor.filmes}}
            <li><a href="/filmes/{{id}}">{{nome}}</a></li>
        {{/each}}
    {{else}}
        <li>Este diretor ainda não dirigiu nenhum filme.</li>
    {{/if}}
</ul>